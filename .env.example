# Discovery configuration. See README.md. Replay needs no provider credentials.
# Copy to a local, gitignored .env. Never put a real credential in this example,
# artifacts, logs, or chat.
AWS_REGION=us-east-1
# Must be a key of MODEL_RATES in src/discovery/bedrock.ts (priced allowlist).
BEDROCK_MODEL=us.amazon.nova-2-lite-v1:0

# sigv4: standard AWS credentials (env vars below, a shared profile, or SSO).
# bearer: a Bedrock API key; some AWS Organizations deny bearer keys by policy.
BEDROCK_AUTH=sigv4
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS_BEARER_TOKEN_BEDROCK=

# Total allowance across discovery attempts, including failed requests.
# This is not a per-run allowance. The implementation caps it at $3.
DISCOVERY_BUDGET_USD=3

# us.* model IDs are US cross-Region inference profiles, not us-east-1-only processing.

# Optional local operator credential (at least 32 non-whitespace characters).
# Otherwise npm run operator:setup creates an owner-only .runs/operator-key.
# OPERATOR_TOKEN=
# Key login is the default. npm run demo:sso starts local SSO automatically.
# For a separate provider, run npm run sso and uncomment these values:
# OPERATOR_AUTH=oidc
# OIDC_ISSUER=http://127.0.0.1:4104
# OIDC_CLIENT_ID=verified-ui-capabilities
# OIDC_ALLOW_INSECURE_LOOPBACK=true
# Service identity for stdio MCP. Tenant grants come from config/access.json.
# MCP_PRINCIPAL=agent-a
# ACCESS_POLICY_PATH=config/access.json
# Replay metadata uses a single-worker directory on a local filesystem.
# RUN_STATE_DIR=.runs/runtime
