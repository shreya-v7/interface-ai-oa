{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023", "DOM"],
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"],
    "noUncheckedIndexedAccess": true
  },
  "include": [
    "src/**/*.ts",
    "sim/**/*.ts",
    "eval/**/*.ts",
    "test/**/*.ts",
    "fixtures/**/*.ts",
    "vitest.config.ts"
  ]
}
